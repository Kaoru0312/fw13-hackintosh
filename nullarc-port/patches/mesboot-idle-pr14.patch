+// [fw13] 移植 luuumi-dev/nullarc PR #14（ae5a464、61a2226、ed747f7）：Linux 在建立第一個佇列前設定、nullarc 0.4.0 漏掉的 CP 狀態。
+//  - CP_MEC_DOORBELL_RANGE 維持重設值 0x110..0xffc，涵蓋 gfx ring 的 doorbell 0x458 → gfx 佇列建立後 CP 永遠 busy
+//    （GRBM_STATUS 0xa800302c），PMFW 看到 99 % 負載。Linux gfx_v11_0_cp_set_doorbell_range 給 compute 0x0..0x450。
+//  - CP_MAX_CONTEXT 7、CP_DEVICE_ID 1（gfx_v11_0_cp_gfx_start）。佇列建立後才寫無效，所以放在最前面。
+// MESBOOT_LEGACY_INIT=1 跳過（回到 0.4.0 行為）。
+static void linux_cp_init(void)
+{
+   if (env_on("MESBOOT_LEGACY_INIT")) { printf("linux cp init: skipped (MESBOOT_LEGACY_INIT)\n"); return; }
+   wr(SEG0(0x1dfd), 0x450); wr(SEG0(0x1dfc), 0);   // CP_MEC_DOORBELL_RANGE_UPPER / _LOWER
+   wr(SEG0(0x1e4e), 7);                            // CP_MAX_CONTEXT
+   wr(SEG0(0x1deb), 1);                            // CP_DEVICE_ID
+   printf("linux cp init: GRBM_STATUS=0x%08x\n", rd(0x2004));
+}
