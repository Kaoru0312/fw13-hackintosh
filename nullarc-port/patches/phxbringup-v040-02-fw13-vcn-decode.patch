+// ==== [fw13] VCN 4.0.2 H.264 解碼 ====
+// 流程跟 FW13 的使用者空間工具 vcn/vcnctl.c decodefile 一樣（2026-11-24 實機：4 支 x264 串流 160 張畫面跟 ffmpeg 逐 byte 相同）：
+// 同一個 unified ring（vcnctl up 建在 VRAM +0xC100000、16 KiB）、同一個 fence（+0xC108000）、IB（+0xC112000），
+// 解碼 buffer 從 +0x0D000000 開始：session 128 KiB | msg | feedback | IT scaling | bitstream（固定 4 MiB）| DPB | context | target。
+// unified-queue IB 格式：libdrm tests/amdgpu/vcn_tests.c；ring 命令：Linux amdgpu vcn_v4_0 unified ring（IB、FENCE、END、NOP）。
+static constexpr uint32_t kFw13VcnBase1 = 0x7e00;   // VCN inst0 segment 1（IP discovery）
+static constexpr uint32_t kFw13RbWptr = kFw13VcnBase1 + 0xad,
+                          kFw13RbEnable = kFw13VcnBase1 + 0x85, kFw13RbBaseLo = kFw13VcnBase1 + 0xea,
+                          kFw13RbBaseHi = kFw13VcnBase1 + 0xeb, kFw13RbSize = kFw13VcnBase1 + 0xec;
+static constexpr uint32_t kFw13RingOff = 0x0C100000, kFw13RingDw = 0x4000 / 4, kFw13FenceOff = 0x0C108000,
+                          kFw13IbOff = 0x0C112000, kFw13IbDw = 43;
+static constexpr uint32_t kFw13DecOff = 0x0D000000, kFw13DecLimit = 0x10000000;
+static constexpr uint32_t kFw13Session = 128u * 1024u, kFw13Msg = kFw13Session, kFw13Fb = kFw13Msg + 4096,
+                          kFw13It = kFw13Fb + 4096, kFw13Bs = kFw13It + 4096, kFw13BsCap = 4u << 20,
+                          kFw13Dpb = (kFw13Bs + kFw13BsCap + 4095u) & ~4095u;
+static inline uint32_t fw13Align4k(uint32_t v) { return (v + 4095u) & ~4095u; }
+
+bool PhxBringup::fw13VcnRingOk() const {
+    if (!mmio || !fbAper || !fbMcBase || fbAperLen < kFw13DecLimit)
+        return false;
+    const uint64_t ringMc = fbMcBase + kFw13RingOff;
+    return (rreg(kFw13RbEnable) & 4u) && rreg(kFw13RbBaseLo) == static_cast<uint32_t>(ringMc) &&
+           rreg(kFw13RbBaseHi) == static_cast<uint32_t>(ringMc >> 32) && rreg(kFw13RbSize) == kFw13RingDw;
+}
+
+void PhxBringup::fw13VcnBarWrite(uint32_t off, const void *src, uint32_t bytes) {
+    volatile uint32_t *d = reinterpret_cast<volatile uint32_t *>(fbAper->getVirtualAddress() + off);
+    const uint8_t *s = static_cast<const uint8_t *>(src);
+    for (uint32_t i = 0; i < bytes / 4; i++) {
+        uint32_t v;
+        memcpy(&v, s + i * 4, 4);
+        d[i] = v;
+    }
+    if (bytes & 3) {
+        uint32_t v = 0;
+        memcpy(&v, s + (bytes & ~3u), bytes & 3);
+        d[bytes / 4] = v;
+    }
+}
+
+void PhxBringup::fw13VcnBarZero(uint32_t off, uint32_t bytes) {
+    volatile uint32_t *d = reinterpret_cast<volatile uint32_t *>(fbAper->getVirtualAddress() + off);
+    for (uint32_t i = 0; i < (bytes + 3) / 4; i++)
+        d[i] = 0;
+}
+
+static void fw13Addr(uint32_t *w, uint64_t mc) {
+    w[0] = static_cast<uint32_t>(mc >> 32);
+    w[1] = static_cast<uint32_t>(mc);
+}
+
+// 寫 IB、送上 ring、等 fence。回傳 PHXN_FW13_VCN_*。呼叫者持有 fw13VcnLock。
+uint32_t PhxBringup::fw13VcnSubmit(bool frame, uint32_t *usOut) {
+    const uint64_t base = fbMcBase + kFw13DecOff;
+    uint32_t ib[kFw13IbDw];
+    bzero(ib, sizeof ib);
+    ib[0] = 16; ib[1] = 0x30000002; ib[3] = kFw13IbDw - 4;                       // single queue checksum
+    ib[4] = 16; ib[5] = 0x30000001; ib[6] = 3; ib[7] = (kFw13IbDw - 4) * 4;      // engine info：decode
+    ib[8] = (kFw13IbDw - 8) * 4; ib[9] = 1;                                       // DECODE_BUFFER
+    ib[10] = 1 | 0x00100000;                                                      // MSG | SESSION_CONTEXT
+    fw13Addr(ib + 11, base + kFw13Msg);
+    fw13Addr(ib + 17, base + 0);
+    if (frame) {
+        const uint32_t oCtx = fw13Align4k(kFw13Dpb + fw13VcnDpb), oDt = fw13Align4k(oCtx + fw13VcnCtx);
+        ib[10] |= 0x00000a1e;   // DPB、bitstream、target、feedback、IT scaling、decoder context
+        fw13Addr(ib + 13, base + kFw13Dpb);
+        fw13Addr(ib + 15, base + oDt);
+        fw13Addr(ib + 19, base + kFw13Bs);
+        fw13Addr(ib + 21, base + oCtx);
+        fw13Addr(ib + 23, base + kFw13Fb);
+        fw13Addr(ib + 31, base + kFw13It);
+    }
+    for (uint32_t i = 4; i < kFw13IbDw; i++)
+        ib[2] += ib[i];
+    fw13VcnBarWrite(kFw13IbOff, ib, sizeof ib);
+
+    const uint32_t seq = ++fw13VcnSeq;
+    const uint64_t ibMc = fbMcBase + kFw13IbOff, fenceMc = fbMcBase + kFw13FenceOff;
+    const uint32_t cmd[] = {2, 0, static_cast<uint32_t>(ibMc), static_cast<uint32_t>(ibMc >> 32), kFw13IbDw,   // IB（vmid 0）
+                            3, static_cast<uint32_t>(fenceMc), static_cast<uint32_t>(fenceMc >> 32), seq,      // FENCE
+                            1};                                                                                // END
+    uint32_t w = rreg(kFw13RbWptr) % kFw13RingDw;
+    volatile uint32_t *ring = reinterpret_cast<volatile uint32_t *>(fbAper->getVirtualAddress() + kFw13RingOff);
+    for (uint32_t i = 0; i < 64; i++)   // 補 NOP 到 64 dword（amdgpu_ring_commit 的 align_mask 0x3f）
+        ring[(w + i) % kFw13RingDw] = i < sizeof cmd / 4 ? cmd[i] : 0;
+    hdpFlush();
+    (void)rreg(0x0DE3);   // 讀回當屏障（同 vcnctl）
+    uint64_t t0;
+    clock_get_uptime(&t0);
+    wreg(kFw13RbWptr, (w + 64) % kFw13RingDw);
+
+    const volatile uint32_t *fence = reinterpret_cast<const volatile uint32_t *>(fbAper->getVirtualAddress() + kFw13FenceOff);
+    uint64_t limit;
+    nanoseconds_to_absolutetime(2000ull * 1000000ull, &limit);
+    for (uint32_t spin = 0;; spin++) {
+        if (*fence == seq)
+            break;
+        uint64_t now;
+        clock_get_uptime(&now);
+        if (now - t0 > limit)
+            return PHXN_FW13_VCN_TIMEOUT;
+        if (spin < 200)
+            IODelay(10);     // 前 2 ms 忙等（720p 一張約 1.5 ms）
+        else
+            IOSleep(1);
+    }
+    uint64_t t1, ns;
+    clock_get_uptime(&t1);
+    absolutetime_to_nanoseconds(t1 - t0, &ns);
+    *usOut = static_cast<uint32_t>(ns / 1000);
+    return PHXN_FW13_VCN_OK;
+}
+
+IOReturn PhxBringup::fw13VcnDec(void *client, task_t task, const uint64_t in[5], uint64_t out[4]) {
+    out[0] = out[1] = out[2] = out[3] = 0;
+    const uint64_t op = in[0], inVa = in[1], inLen = in[2], outVa = in[3], outLen = in[4];
+    if (!fw13VcnLock || !task || op < 1 || op > 3 || !inVa || inLen < sizeof(phxn_fw13_vcn_hdr) || inLen > kFw13BsCap + 65536)
+        return kIOReturnBadArgument;
+    IOMemoryDescriptor *inMd = IOMemoryDescriptor::withAddressRange(inVa, inLen, kIODirectionOut, task);
+    if (!inMd)
+        return kIOReturnNoMemory;
+    IOReturn r = inMd->prepare();
+    if (r != kIOReturnSuccess) {
+        inMd->release();
+        return r;
+    }
+    phxn_fw13_vcn_hdr h;
+    inMd->readBytes(0, &h, sizeof h);
+    const uint64_t body = static_cast<uint64_t>(h.msg_len) + h.its_len + h.bs_len;
+    if (h.magic != PHXN_FW13_VCN_MAGIC || h.msg_len > 4096 || h.its_len > 4096 || h.bs_len > kFw13BsCap ||
+        sizeof h + body > inLen) {
+        inMd->complete();
+        inMd->release();
+        return kIOReturnBadArgument;
+    }
+
+    IOLockLock(fw13VcnLock);
+    uint32_t st = PHXN_FW13_VCN_OK, us = 0;
+    do {
+        if (isSleeping || !fw13VcnRingOk()) { st = PHXN_FW13_VCN_NOT_UP; break; }
+        if (fw13VcnOwner && fw13VcnOwner != client) { st = PHXN_FW13_VCN_BUSY; break; }
+        if (op == 1) {
+            if (fw13VcnOwner) { st = PHXN_FW13_VCN_BUSY; break; }   // 同一個 client 一次只能開一個 session
+            const uint64_t need = static_cast<uint64_t>(kFw13DecOff) + kFw13Dpb + fw13Align4k(h.dpb_size) +
+                                  fw13Align4k(h.ctx_size) + h.dt_size;
+            if (!h.dpb_size || !h.ctx_size || !h.dt_size || need > kFw13DecLimit) { st = PHXN_FW13_VCN_LAYOUT; break; }
+            fw13VcnDpb = h.dpb_size;
+            fw13VcnCtx = h.ctx_size;
+            fw13VcnDt = h.dt_size;
+            fw13VcnHandle = h.handle;
+            // 清 session、DPB、context（同 vcnctl：清整段）
+            fw13VcnBarZero(kFw13DecOff, kFw13Bs);
+            fw13VcnBarZero(kFw13DecOff + kFw13Dpb, fw13Align4k(kFw13Dpb + h.dpb_size) - kFw13Dpb + fw13Align4k(h.ctx_size));
+        } else {
+            if (fw13VcnOwner != client) { st = PHXN_FW13_VCN_NO_SESSION; break; }
+            if (h.dpb_size != fw13VcnDpb || h.ctx_size != fw13VcnCtx || h.dt_size != fw13VcnDt || h.handle != fw13VcnHandle) {
+                st = PHXN_FW13_VCN_LAYOUT;
+                break;
+            }
+        }
+        // msg、IT、bitstream 從 user buffer 分段搬進 BAR
+        uint8_t bounce[512];
+        const struct { uint32_t dst, len; } parts[] = {{kFw13Msg, h.msg_len}, {kFw13It, h.its_len}, {kFw13Bs, h.bs_len}};
+        uint64_t src = sizeof h;
+        fw13VcnBarZero(kFw13DecOff + kFw13Msg, 4096);
+        for (const auto &pt : parts) {
+            for (uint32_t o = 0; o < pt.len; o += sizeof bounce) {
+                const uint32_t n = pt.len - o < sizeof bounce ? pt.len - o : static_cast<uint32_t>(sizeof bounce);
+                inMd->readBytes(src + o, bounce, n);
+                fw13VcnBarWrite(kFw13DecOff + pt.dst + o, bounce, n);
+            }
+            src += pt.len;
+        }
+        if (op == 2) {
+            const uint32_t fbInit[2] = {0x2c, 0x2c};   // 同 libdrm 向量的 feedback 初值
+            fw13VcnBarWrite(kFw13DecOff + kFw13Fb, fbInit, sizeof fbInit);
+            fw13VcnBarZero(kFw13DecOff + kFw13Bs + h.bs_len, 64);
+        }
+        st = fw13VcnSubmit(op == 2, &us);
+        if (st != PHXN_FW13_VCN_OK)
+            break;
+        if (op == 1)
+            fw13VcnOwner = client;
+        if (op == 3)
+            fw13VcnOwner = nullptr;
+        if (op == 2) {
+            out[3] = reinterpret_cast<const volatile uint32_t *>(fbAper->getVirtualAddress() + kFw13DecOff + kFw13Fb)[3];
+            if (outVa && outLen) {
+                const uint32_t oDt = fw13Align4k(fw13Align4k(kFw13Dpb + fw13VcnDpb) + fw13VcnCtx);
+                const uint32_t n = outLen < fw13VcnDt ? static_cast<uint32_t>(outLen) : fw13VcnDt;
+                IOMemoryDescriptor *outMd = IOMemoryDescriptor::withAddressRange(outVa, n, kIODirectionIn, task);
+                if (outMd && outMd->prepare() == kIOReturnSuccess) {
+                    const volatile uint8_t *pix = reinterpret_cast<const volatile uint8_t *>(fbAper->getVirtualAddress() + kFw13DecOff + oDt);
+                    uint32_t chunk[256];   // 核心堆疊有限：每次 1 KiB
+                    for (uint32_t o = 0; o < n; o += sizeof chunk) {
+                        const uint32_t m = n - o < sizeof chunk ? n - o : static_cast<uint32_t>(sizeof chunk);
+                        const volatile uint32_t *p32 = reinterpret_cast<const volatile uint32_t *>(pix + o);
+                        for (uint32_t i = 0; i < (m + 3) / 4; i++)
+                            chunk[i] = p32[i];
+                        outMd->writeBytes(o, chunk, m);
+                    }
+                    outMd->complete();
+                } else {
+                    r = kIOReturnNoMemory;
+                }
+                if (outMd)
+                    outMd->release();
+            }
+        }
+    } while (false);
+    out[0] = st;
+    out[1] = fw13VcnSeq;
+    out[2] = us;
+    IOLockUnlock(fw13VcnLock);
+    inMd->complete();
+    inMd->release();
+    return r;
+}
+
+void PhxBringup::fw13VcnRelease(void *client) {
+    if (!fw13VcnLock)
+        return;
+    IOLockLock(fw13VcnLock);
+    if (fw13VcnOwner == client) {
+        if (!isSleeping && fw13VcnRingOk()) {
+            const uint32_t destroy[6] = {40, 24, 0, 2, fw13VcnHandle, 0};
+            fw13VcnBarZero(kFw13DecOff + kFw13Msg, 4096);
+            fw13VcnBarWrite(kFw13DecOff + kFw13Msg, destroy, sizeof destroy);
+            uint32_t us = 0;
+            fw13VcnSubmit(false, &us);
+        }
+        fw13VcnOwner = nullptr;
+    }
+    IOLockUnlock(fw13VcnLock);
+}
+
+IOReturn IOAccelPhxNativeClient::doFw13VcnDec(IOExternalMethodArguments *a) {
+    if (!shape(a, 5, 4, 0, 0))
+        return kIOReturnBadArgument;
+    uint64_t out[4];
+    const IOReturn r = owner->fw13VcnDec(this, task, a->scalarInput, out);
+    for (int i = 0; i < 4; i++)
+        a->scalarOutput[i] = out[i];
+    return r;
+}
