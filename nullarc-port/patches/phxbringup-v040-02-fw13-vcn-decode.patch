+++ b/src/phxbringup/PhxNativeABI.h	2026-11-24 11:36:07.334065128 +0000
@@ -66,6 +66,11 @@
     PHXN_SEL_DBG_CLAIM = 113,      /* in: [0] 1 = mark the GPU driven (nmxgpu-claimed) and re-run matching so PhxAccel starts. */
     PHXN_SEL_DBG_SYSMEM = 111,     /* in: [0] op (1 alloc [1] bytes, 2 read [1] off, 3 write [1] off [2] val, 4 free)  out: [0] phys  [1] len/value */
     PHXN_SEL_DBG_DOORBELL = 110,   /* in: [0] doorbell BAR2 byte offset (8-aligned) [1] value lo [2] value hi; writes a 64-bit doorbell. */
+    /* [fw13] VCN 4.0.2 H.264 解碼（不需 phxdebug／root）。VCN 本身由 root 的 vcnctl up 先帶起來（ring 在 VRAM +0xC100000）。
+     * in: [0] op（1 建立 session、2 解碼一張、3 關閉 session）[1] 輸入的 user VA [2] 輸入長度 [3] 輸出的 user VA（op 2）[4] 輸出長度
+     * 輸入 = struct phxn_fw13_vcn_hdr ＋ msg[msg_len] ＋ its[its_len] ＋ bitstream[bs_len]（message 由 user space 組好）
+     * out: [0] 狀態（PHXN_FW13_VCN_*）[1] fence seq [2] VCN 花的時間（µs）[3] 讀回的 feedback dword 3 */
+    PHXN_SEL_FW13_VCN_DEC = 130,
 };
 
 /* GPU memory layout registers (MMHUB 3.0.1 segment 1 = 0x1A000): Linux mmhub_v3_0_1_get_fb_location / get_mc_fb_offset */
@@ -222,4 +227,22 @@
 static_assert(sizeof(struct phxn_cs_in) == 32, "cs_in is 32 B");
 static_assert(sizeof(struct phxn_info) == 192, "info is 192 B");
 
+/* [fw13] PHXN_SEL_FW13_VCN_DEC 的輸入標頭 */
+#define PHXN_FW13_VCN_MAGIC 0x44333146u   /* "F13D" */
+struct phxn_fw13_vcn_hdr {
+    uint32_t magic;
+    uint32_t handle;          /* session handle（必須跟 msg 裡的一樣；kext 在 client 關掉時用它補送 destroy） */
+    uint32_t msg_len, its_len, bs_len;
+    uint32_t dpb_size, ctx_size, dt_size;   /* op 1 決定版面，op 2／3 必須相同 */
+    uint32_t reserved[8];
+};
+enum {
+    PHXN_FW13_VCN_OK = 0,
+    PHXN_FW13_VCN_NOT_UP = 1,      /* VCN ring 不在預期的位置（沒跑 vcnctl up） */
+    PHXN_FW13_VCN_BUSY = 2,        /* 別的 client 正在用 */
+    PHXN_FW13_VCN_TIMEOUT = 3,     /* fence 2 秒內沒回來 */
+    PHXN_FW13_VCN_LAYOUT = 4,      /* 版面超出範圍或跟 session 不符 */
+    PHXN_FW13_VCN_NO_SESSION = 5,
+};
